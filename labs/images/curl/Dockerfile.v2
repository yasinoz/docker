# specifying an exact version makes the build repeatable
FROM alpine:3.16

# using the no-cache option creates a smaller image
RUN apk add --no-cache curl=8.5.0-r0

# NOT: Alpine guvenlik yamasi cikardiginda eski paket surumunu
# depodan KALDIRIYOR. Bu satir 7.83.1-r3'e sabitlenmisti ve
# "unable to select packages" hatasiyla build'i durduruyordu.
# Tam surum sabitlemek tekrarlanabilirlik veriyor ama bakim
# gerektiriyor - golden-images labinda ayni odunlesim isleniyor.

# entrypoint lets users add options when the container starts
ENTRYPOINT ["curl"]